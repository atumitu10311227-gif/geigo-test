# Keep disabled until the owner approves API charges and configures the account.
PILOT_AI_ENABLED=false
# Set only in the deployment environment, never in public code or in chat.
OPENAI_API_KEY=
# Required: choose a Responses-API / structured-output compatible model after checking price and access.
OPENAI_MODEL=
# Optional. Leave blank unless the selected model supports it. A high effort may exhaust the output cap.
OPENAI_REASONING_EFFORT=
# A private, randomly generated code of at least 16 characters. Share only with authorized pilot users.
PILOT_ACCESS_CODE=
