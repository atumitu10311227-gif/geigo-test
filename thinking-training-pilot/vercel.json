{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "",
  "functions": {"api/ai.js": {"maxDuration": 120, "includeFiles": "server/**"}},
  "headers": [{"source": "/(.*)", "headers": [
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"},
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
    {"key":"Cache-Control","value":"no-store"}
  ]}]
}
